{
  "id": "/markdown-editor/",
  "name": "MD//WORKS Editor",
  "short_name": "MD//WORKS",
  "start_url": "/markdown-editor/",
  "scope": "/markdown-editor/",
  "display": "standalone",
  "theme_color": "#090b11",
  "background_color": "#090b11",
  "icons": [
    {
      "src": "images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "/markdown-editor/",
      "name": "Markdown and text files",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  }
}
